msgid "Theme"
msgstr "Tema"

#: ../../user_guide/apps/slides.rst:43
msgid "|gear| **Options**:"
msgstr "|gear| **Opzioni**:"

#: ../../user_guide/apps/slides.rst:45
msgid "**Layout**: Toggle slide numbers, date, title, and transitions."
msgstr ""

#: ../../user_guide/apps/slides.rst:46
msgid "**Background Image**: Displayed on all slides."
msgstr ""

