#: ../../how_to_contribute.rst:25
msgid "`AlternativeTo <https://alternativeto.net/software/cryptpad/about/>`__"
msgstr "`AlternativeTo <https://alternativeto.net/software/cryptpad/about/>`__"

#: ../../how_to_contribute.rst:26
msgid "`Slant <https://www.slant.co/options/31378/~cryptpad-review>`__"
msgstr "`Slant <https://www.slant.co/options/31378/~cryptpad-review>`__"

#: ../../how_to_contribute.rst:27
msgid "`Product Hunt <https://www.producthunt.com/products/cryptpad#cryptpad>`__"
msgstr ""
"`Product Hunt <https://www.producthunt.com/products/cryptpad#cryptpad>`__"

#: ../../how_to_contribute.rst:28
msgid "`SourceForge <https://sourceforge.net/software/product/CryptPad/>`__"
msgstr "`SourceForge <https://sourceforge.net/software/product/CryptPad/>`__"

#: ../../how_to_contribute.rst:29
msgid "`Slashdot <https://slashdot.org/software/p/CryptPad/>`__"
msgstr "`Slashdot <https://slashdot.org/software/p/CryptPad/>`__"

